# Append to the .env that `ogna init` generates.

# --- Platform API ---
API_IMAGE=ogna-platform-api:dev
# "hetzner" creates real servers (billed!); "fake" simulates them
OGNA_PLATFORM_PROVIDER=fake
HETZNER_API_TOKEN=
# Optional: SSH key ids/names registered in your Hetzner project, for break-glass access
HETZNER_SSH_KEY_IDS=
OGNA_PLATFORM_REGIONS=fsn1,nbg1,hel1
OGNA_PLATFORM_DEFAULT_STACK_VERSION=main
# Projects get https://<slug>.<base domain> once DNS is wired up
OGNA_PLATFORM_BASE_DOMAIN=ogna.local
# Public URL of this control plane (written into each VPS for the future agent)
OGNA_PLATFORM_PUBLIC_URL=http://localhost:8000
# Comma-separated user ids allowed to change plans (see GET /api/v1/account -> user_id)
OGNA_PLATFORM_ADMIN_USER_IDS=
# Seconds between reconcile passes (0 disables); provisioning timeout in seconds
OGNA_PLATFORM_RECONCILE_INTERVAL=30
OGNA_PLATFORM_PROVISION_TIMEOUT=900
# Leave empty until the agent exists; must be https
OGNA_AGENT_INSTALL_URL=
