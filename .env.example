# Secrets below are placeholders. `make env` copies this file to .env and
# replaces every change_me value with a random one. The gateway refuses to
# start with placeholder or example secrets.
POSTGRES_USER=ogna_user
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=ogna_db
POSTGRES_NON_ROOT_USER=ogna_user
POSTGRES_NON_ROOT_PASSWORD=change_me_postgres_password
ENCRYPTION_KEY=change_me_encryption_key
GOTRUE_JWT_SECRET=change_me_gotrue_jwt_secret
API_EXTERNAL_URL="localhost:8000"
API_IMAGE="ogna-py-appi:prod"
STORAGE_TYPE="S3"
S3_SECRET_KEY=rustfsadmin
S3_ENDPOINT_URL=http://rustfs:9000
S3_ACCESS_KEY=rustfsadmin
AUTHENTIK_SECRET_KEY=super-long-random-string
GOTRUE_JWT_EXP=3600
OGNA_GATEWAY_DB_PASSWORD=change_me_gateway_db_password
HASURA_GRAPHQL_ADMIN_SECRET=change_me_hasura_admin_secret

# --- Auth settings to review before production ---
# Public URL of your app; email links and OAuth redirects default here
GOTRUE_SITE_URL=http://localhost
# Extra allowed redirect URLs (comma-separated, wildcards allowed), e.g. https://app.example.com/**
GOTRUE_URI_ALLOW_LIST=
# Set to false in production so users must confirm their email (requires SMTP below)
GOTRUE_MAILER_AUTOCONFIRM=true
# GOTRUE_SMTP_HOST=smtp.example.com
# GOTRUE_SMTP_PORT=587
# GOTRUE_SMTP_USER=
# GOTRUE_SMTP_PASS=
# GOTRUE_SMTP_ADMIN_EMAIL=no-reply@example.com
# Browser origins allowed by CORS (comma-separated). Default: localhost dev ports.
# OGNA_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Per-IP limits on /auth/token, /auth/signup, /auth/recover, /auth/otp, /auth/magiclink.
# Raise these when running the integration test suite (e.g. 1000 / 10000).
OGNA_AUTH_RATE_LIMIT_MINUTE=10
OGNA_AUTH_RATE_LIMIT_HOUR=100
